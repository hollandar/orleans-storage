<h3>Edit Tile</h3>

<EditForm Model="this.tile" OnValidSubmit="SaveTileAsync">
	<FluentValidator TModelType="TileModel" TValidator="TileModelValidator"/>

	<div class="field">

		<div class="field">
			<label for="url">Image Resource</label>
			<InputSelectFile Library="@Library" id="url" @bind-Value="tile.ImageUri" />
			<ValidationMessage For="@(() => tile.ImageUri)" />
			<p class="hint">A url to an image for the tile, this will be used in preference to the icon resource.</p>
		</div>

		<div class="field">
			<label for="IconResource">Icon Resource</label>
			<InputText type="text" @bind-Value="tile.IconResource" />
			<ValidationMessage For="() => tile.IconResource" />
			<p class="hint">A reference to an icon from the style library.  Font Awesome is the standard icon library.  For example "fa-solid fa-user fa-2x".</p>
		</div>

		<div class="field">
			<label for="Title">Title</label>
			<InputText type="text" @bind-Value="tile.Title" />
			<ValidationMessage For="() => tile.Title" />
		</div>

		<div class="field">
			<label for="Md">Content (Markdown)</label>
			<InputTextArea @bind-Value="tile.Md" rows="5" />
			<ValidationMessage For="() => tile.Md" />
		</div>

		<div class="actions">
				<button class="button primary" type="submit">Save</button>
				<button type="button" class="button secondary" @onclick="CancelModelAsync">Cancel</button>
		</div>

	</div>

</EditForm>
@code {
	[CascadingParameter(Name = "CadenceUploadContentLibraryKey")] public string Library { get; set; } = string.Empty;
	[CascadingParameter(Name = "Model")] public TilesModel Model { get; set; } = default!;
	[CascadingParameter(Name = "Editor")] public TilesBlockEditor Editor { get; set; } = default!;
	TileModel tile = new();

	protected override async Task OnInitializedAsync()
	{
		if (Editor.State.Mode == TilesBlockEditor.EditorMode.AddTile && Editor.State.TileId is null)
		{
			tile = new()
				{
					Id = Guid.NewGuid(),
					Title = "",
					Md = "",
					IconResource = string.Empty,
					ImageUri = string.Empty
				};
		} else
		{
			var tileEditing = Model.Tiles.FirstOrDefault(r => r.Id == Editor.State.TileId) ?? throw new InvalidOperationException($"Tile {Editor.State.TileId} not found.");
			tile = new()
				{
					Id = tileEditing.Id,
					Title = tileEditing.Title,
					Md = tileEditing.Md,
					IconResource = tileEditing.IconResource,
					ImageUri = tileEditing.ImageUri
				};
		}
		await base.OnInitializedAsync();
	}

	protected async Task SaveTileAsync()
	{
		var tileEditing = Model.Tiles.FirstOrDefault(r => r.Id == Editor.State.TileId);

		if (tileEditing is null)
		{
			tileEditing = new() { Id = tile.Id };
			Model.Tiles.Add(tileEditing);
		}

		tileEditing.Title = tile.Title;
		tileEditing.Md = tile.Md;
		tileEditing.IconResource = tile.IconResource;
		tileEditing.ImageUri = tile.ImageUri;

		await Editor.SetEditorModeAsync(TilesBlockEditor.EditorMode.View, null);
	}

	protected async Task CancelModelAsync()
	{
		await Editor.SetEditorModeAsync(TilesBlockEditor.EditorMode.View, null);
	}
}

