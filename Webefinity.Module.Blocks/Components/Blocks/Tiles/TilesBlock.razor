@inherits BlockComponentBase<TilesModel>
@attribute [BlockAttribute("tiles", "Tiles", "A block that renders a number of tiles.")]
<div class="container">
    <div class="@TilesSectionClass()">
        @if (!TilesSectionClass().Contains("no-highlight"))
        {
            <div class="tiles-highlight">
                <div class="tiles-highlight-content" style="color: @Model.TextColor">
                    <h3>@Model.Title</h3>
                    <Markdown Md="@Model.Md" />
                </div>
                <img 
                    src="@UriTransformer.Transform(this.Model.ImageUri)"
                    sizes="512px"
                    srcset="@UriTransformer.TransformSrcSet(this.Model.ImageUri)"
                    class="tiles-highlight-image object-position-scroll object-fit-cover"
                    alt="@Model.Title" />
            </div>
        }

        <div class="@ContainerClass()">
            @foreach (var tile in Model.Tiles)
            {
                <div class="tiles-item">
                    <div class="tiles-image">
                        @if (!String.IsNullOrWhiteSpace(tile.ImageUri))
                        {
                            <img src="@UriTransformer.Transform(tile.ImageUri)"
                                 sizes="300px"
                                 srcset="@UriTransformer.TransformSrcSet(tile.ImageUri)"
                                 class="tiles-image object-fit-cover"
                                 alt="@tile.Title" />
                        }
                        else if (!string.IsNullOrWhiteSpace(tile.IconResource))
                        {
                            <i class="@tile.IconResource"></i>
                        }
                    </div>
                    <div class="tiles-content">
                        <h4>@tile.Title</h4>
                        <Markdown Md="@tile.Md" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    protected string ContainerClass()
    {
        if (Model.Tiles.Count % 4 == 0)
        {
            return "tiles-container tiles-columns-4";
        }
        else if (Model.Tiles.Count % 3 == 0)
        {
            return "tiles-container tiles-columns-3";
        }
        else if (Model.Tiles.Count % 2 == 0)
        {
            return "tiles-container tiles-columns-2";
        }
        else
        {
            return "tiles-container tiles-columns-1";
        }
    }

    protected string TilesSectionClass()
    {
        if (String.IsNullOrWhiteSpace(Model.Md) && String.IsNullOrWhiteSpace(Model.ImageUri) && String.IsNullOrWhiteSpace(Model.Title))
        {
            return "tiles-section no-highlight";
        }
        else
        {
            return "tiles-section";
        }
    }
}
