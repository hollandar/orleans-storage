@using Webefinity.Module.Blocks.Components.Blocks

@inherits BlockEditorComponentBase<HeroModel>
@attribute [BlockEditor("hero")]

<h3>Edit Hero</h3>

<EditForm @ref="editForm" Model="this.Model" OnValidSubmit="SaveModel">
    <FluentValidator TModelType="HeroModel" TValidator="HeroModelValidator" />

    <div class="field">
        <label for="text">Text</label>
        <InputTextArea rows="10" id="text" @bind-Value="Model.Left" />
        <ValidationMessage For="@(() => Model.Left)" />
    </div>

    <div class="field">
        <label for="text">Text</label>
        <InputTextArea rows="10" id="text" @bind-Value="Model.Right" />
        <ValidationMessage For="@(() => Model.Right)" />
    </div>

    <div class="field">
        <label for="url">Background</label>
        <InputSelectFile Library="@Library" id="url" @bind-Value="Model.Url" />
        <ValidationMessage For="@(() => Model.Url)" />
    </div>

    <div class="field">
        <label for="text-color">Text Color</label>
        <InputColor id="text-color" @bind-Value="Model.TextColor" />
        <ValidationMessage For="@(() => Model.TextColor)" />
    </div>

    <div class="actions">
        <Button class="primary" type="button" Clicked="Apply">Apply</Button>
        <Button class="primary" type="submit">Save</Button>
        <Button class="secondary" Clicked="CancelModel">Cancel</Button>
    </div>
</EditForm>

@code {
    [CascadingParameter(Name = "CadenceUploadContentLibraryKey")] public string Library { get; set; } = string.Empty;
    EditForm editForm = default!;

    protected async Task Apply()
    {
        if (editForm.EditContext?.Validate() ?? false)
        {
            await this.ApplyModel();
        }
    }
}
