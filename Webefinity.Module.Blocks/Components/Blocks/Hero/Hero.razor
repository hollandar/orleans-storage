@using Webefinity.Module.Blocks
@using Webefinity.Module.Blocks.Components.Blocks
@inherits BlockComponentBase<HeroModel>
@attribute [BlockAttribute("hero", "Hero", "A responsive hero.")]

<section class="container">
    <div class="hero">
        <div class="center">

            <Markdown Md="@Model.Text" />


        </div>
        <img src="@UriTransformer.TransformSize(this.Model.Url, String.Empty, "unspecified.jpg")" alt="Hero Image" class="hero-image"
             srcset="@UriTransformer.TransformSize(this.Model.Url, String.Empty, "unspecified.jpg") 2560w,
        @UriTransformer.TransformSize(this.Model.Url, String.Empty, "unspecified.jpg") 1920w,
        @UriTransformer.TransformSize(this.Model.Url, String.Empty, "unspecified.jpg") 1024w" />
    </div>
</section>

@code {

}
