@using Webefinity.Module.Blocks
@using Webefinity.Module.Blocks.Components.Blocks
@using Webefinity.Module.Blocks.Components.Shared
@inherits BlockComponentBase<HeroModel>
@attribute [BlockAttribute("hero", "Hero", "A responsive hero.")]

<section class="container">
    <div class="hero">

        <div class="hero-content">
            <div class="hero-section-left" style="color: @Model.TextColor">
                @if (!string.IsNullOrWhiteSpace(Model.Left))
                {
                    <div class="hero-backdrop">
                        <Markdown Md="@Model.Left" />
                    </div>
                }
            </div>

            <div class="hero-section-right" style="color: @Model.TextColor">
                @if (!string.IsNullOrWhiteSpace(Model.Right))
                {
                    <div class="hero-backdrop">
                        <Markdown Md="@Model.Right" />
                    </div>
                }
            </div>
        </div>

        <img src="@UriTransformer.Transform(this.Model.Url)"
             srcset="@UriTransformer.TransformSrcSet(this.Model.Url)"
             sizes="100vw"
             class="hero-image object-position-scroll object-fit-cover"
             alt="Hero Image" />
    </div>
</section>

