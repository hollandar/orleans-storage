@page "/article/{id}"

@inject IServiceProvider ServiceProvider
@inject IOptions<BlogOptions> BlogOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject ArticleContentService ArticleContentService
@inject NavigationManager NavigationManager

<HeadContent>
    <meta name="description" content="@this.properties?.Summary" />
    <link rel="canonical" href="https://www.sports-trainer.com.au/article/@this.Id" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://www.sports-trainer.com.au/article/@this.Id" />
</HeadContent>

<section class="gutter constrained p-t-4 p-b-4">

    @if (found)
    {
        @if (this.properties is not null)
        {
            if (this.BlogOptions.Value.SiteTitle is not null)
            {
                <PageTitle>@this.properties.Title - @this.BlogOptions.Value.SiteTitle</PageTitle>
            }
            else
            {
                <PageTitle>@this.properties.Title</PageTitle>
            }

            <BackH1 BackUrl="@(ReturnUrl ?? "/")">@this.properties.Title</BackH1>

            <p>@this.properties.Date.Humanize() by @this.properties.Author</p>

            @if (this.isAuthorized)
            {

                <div class="actions">
                        <div class="@ArticleStatusBadgeStateHelper.GetBadgeState(this.properties.State)">@this.properties.State</div>
                    <a href="@NavigationManager.NavigationString($"/article/edit/{this.Id}", ReturnUrl)" class="button secondary"><i class="fa-solid fa-pencil"></i> Edit</a>
                </div>
            }
        }

        <article>
            @(new MarkupString(this.html))
        </article>

        @if (this.properties.Tags.Length > 0)
        {
            <div class="tags-container">
                @foreach (var tag in this.properties.Tags)
                {
                    <span class="tag">@tag</span>
                }
            </div>
        }

        
    }
    else
    {
        <BackH1 BackUrl="@(ReturnUrl ?? "/")">Article Not Found</BackH1>
        <p>The article you have requested does not exist, maybe the link is wrong?</p>
    }
</section>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "r")] public string? ReturnUrl { get; set; } = null;
    [Parameter] public string Id { get; set; }

    string html = string.Empty;
    ArticleFrontmatter? properties = null;
    bool found = false;
    private bool isAuthorized = false;
    private AuthenticationState authenticationState;

    class ImageExtension : IMarkdownExtension
    {

        public void Setup(MarkdownPipelineBuilder pipeline)
        {
            pipeline.DocumentProcessed += ChangeImgPath;
        }

        public void ChangeImgPath(MarkdownDocument document)
        {
            foreach (LinkInline link in document.Descendants<LinkInline>())
            {
                if (link.IsImage)
                    link.Url = "/c/blog/" + link.Url;
            }
        }

        public void Setup(MarkdownPipeline pipeline, IMarkdownRenderer renderer)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        this.authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        foreach (var policy in this.BlogOptions.Value.AuthorSecurityPolicies)
        {
            if ((await this.AuthorizationService.AuthorizeAsync(this.authenticationState.User, policy)).Succeeded)
            {
                this.isAuthorized = true;
                break;
            }
        }

        var articleContent = await ArticleContentService.GetArticleContentAsync(Id, CancellationToken.None);
        this.found = articleContent.Result == ResultType.Found;
        if (found)
        {
            this.properties = articleContent.Properties;
            var markdownPipeline = new MarkdownPipelineBuilder().Use<ImageExtension>().Build();
            this.html = Markdig.Markdown.ToHtml(articleContent.Content, markdownPipeline);

        }
        else
        {
            this.properties = null;
            this.html = string.Empty;
        }

        await base.OnInitializedAsync();
    }
}
